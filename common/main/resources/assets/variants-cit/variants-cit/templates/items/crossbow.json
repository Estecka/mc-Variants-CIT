{
	"model": {
		"type": "select",
		"property": "charge_type",
		"cases": [
			{
				"when": "arrow",
				"model": { "type":"model", "model":"${INPUT_ID}_arrow" }
			},
			{
				"when": "rocket",
				"model": { "type":"model", "model":"${INPUT_ID}_firework" }
			}
		],
		"fallback": {
			"type": "condition",
			"property": "using_item",
			"on_false": { "type":"model", "model":"${INPUT_ID}" },
			"on_true":
			{
				"type": "range_dispatch",
				"property": "crossbow/pull",
				"fallback": { "type":"model", "model":"${INPUT_ID}_pulling_0" },
				"entries": [
					{
						"threshold": 0.58,
						"model": { "type":"model", "model":"${INPUT_ID}_pulling_1" }
					},
					{
						"threshold": 1.0,
						"model": { "type":"model", "model":"${INPUT_ID}_pulling_2" }
					}
				]
			}
		}
	}
}
