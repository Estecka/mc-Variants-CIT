{
	"model": {
		"type": "select",
		"property": "display_context",
		"cases": 
		[{
			"when": [ "gui", "ground", "fixed", "on_shelf" ],
			"model": { "type":"model", "model":"${INPUT_ID}" }
		}],
		"fallback":
		{
			"type": "condition",
			"property": "using_item",
			"on_false": {
				"type": "special",
				"base": "item/trident_in_hand",
				"model": { "type": "trident" }
			},
			"on_true": {
				"type": "special",
				"base": "item/trident_throwing",
				"model": { "type": "trident" }
			}
		}
	}
}
