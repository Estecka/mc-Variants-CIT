[
	{
		"pass": "models_from_textures",
		"inputPath": "(.*)_in_hand",
		"outputPath": "$1_in_hand",
		"radicalPath": "$1",
		"template": "models/parent",
		"variables": { "modelParent": "variants-cit:item/trident_in_hand" }
	},
	{
		"pass": "models_from_textures",
		"inputPath": "(.*)_in_hand",
		"outputPath": "$1_throwing",
		"radicalPath": "$1",
		"template": "models/parent",
		"variables": { "modelParent": "variants-cit:item/trident_throwing" }
	},
	{
		"pass": "models_from_textures",
		"inputPath": "(?!.*(_in_hand|_throwing)).*",
		"template": "models/item/handheld"
	},
	{
		"pass": "items_from_models",
		"inputPath": "(?!.*(_in_hand|_throwing)).*",
		"template": "items/trident"
	}
]
